# Copy to .env.local and fill in. Never commit .env.local.
# Values are in the Supabase dashboard: Project Settings -> API (and API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Used by the browser/server clients in lib/supabase and by scripts/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=

# Public client key: the legacy "anon" JWT or a new "sb_publishable_..." key.
# Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key: the legacy "service_role" JWT or a new "sb_secret_..." key.
# Bypasses RLS. Used by scripts/seed.ts, the reminder cron job and unsubscribe links.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used for auth redirect/callback links.
# Must also be listed under Authentication -> URL Configuration in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sprint 3: review reminders -------------------------------------------

# Resend API key (resend.com -> API Keys). Server-only.
RESEND_API_KEY=

# Sender for reminder emails, e.g. "RAG Course <reminders@yourdomain.com>".
# The domain must be verified in Resend. Resend's test sender
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM_EMAIL=

# Shared secret for the hourly cron call (sent as "Authorization: Bearer <value>")
# and for signing unsubscribe links. Generate with: openssl rand -base64 32
CRON_SECRET=

# Reminder emails are only actually sent when this is exactly "true".
# Anything else makes /api/cron/review-reminders a dry run.
REVIEW_REMINDERS_ENABLED=false
